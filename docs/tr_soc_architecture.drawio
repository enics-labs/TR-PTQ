                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;useMaxWidth&#39;: false, &#39;gantt&#39;: {&#39;useWidth&#39;: 1100}}}%%\ngantt\n    title VPU Operation FSM Sequences\n    dateFormat  s\n    axisFormat  %S\n    \n    section GELU (21 Cycles)\n    P1 | alpha_stabilizer + tr_exp :a1, 0, 4s\n    P1 | vec_mul                   :a2, after a1, 4s\n    P2 | tr_ln + tr_exp            :a3, after a2, 4s\n    P2 | vec_mul                   :a4, after a3, 4s\n    P3 | symmetry_modifier + vec_mul         :a5, after a4, 5s\n    \n    section Softmax (24 Cycles)\n    P1 | piped_max          :b1, 0, 3s\n    P2 | sub + tr_exp       :b2, after b1, 4s\n    P2 | mac_array_engine   :b3, after b2, 5s\n    P3 | tr_ln              :b4, after b3, 4s\n    P4 | sub + tr_exp       :b5, after b4, 4s\n    P4 | vec_mul            :b6, after b5, 4s\n    \n    section RMSNorm (23 Cycles)\n    P1 | mac_array_engine   :c1, 0, 6s\n    P2 | tr_ln              :c2, after c1, 4s\n    P3 | tr_exp             :c3, after c2, 4s\n    P3 | vec_mul            :c4, after c3, 4s\n    P4 | vec_mul            :c5, after c4, 5s&quot;&#xa;}" id="Nl3iflStya3oSt6hl9kQ-1">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;strokeColor=light-dark(#737373, #ededed);" vertex="1" parent="1">
                        <mxGeometry x="860" y="30" width="830" height="367" as="geometry"/>
