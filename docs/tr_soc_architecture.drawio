    <diagram id="5nv7O9U8NNK0zNJOl2SJ" name="03_VPU_Sequence">
        <mxGraphModel dx="105" dy="1147" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0">
            <root>
